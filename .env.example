# Copiar a .env en la raíz del proyecto. Ese archivo no se sube al repo (.gitignore).

# --- Base de datos ---
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/NOMBRE_BD?sslmode=require&channelBinding=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Opción: credenciales en la URL (entonces username/password pueden ir vacíos arriba)
# SPRING_DATASOURCE_URL=jdbc:postgresql://user:pass@host:5432/db?sslmode=require

# --- JWT (mínimo 32 caracteres en texto) ---
# Nombre AUTH_JWT_SECRET evita que un JWT_SECRET corto en el sistema/IDE pise este valor.
AUTH_JWT_SECRET=dev-cambia-este-secreto-por-uno-largo-minimo-treinta-y-dos-caracteres
JWT_EXPIRATION_MS=86400000

# --- Opcional ---
# SERVER_PORT=8081
